generator client {
  provider = "prisma-client"
  output = "./src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Applied foundation models remain unchanged; identity is added by a new migration.
model RuntimeMetadata {
  key       String   @id @db.VarChar(64)
  value     String   @db.VarChar(128)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@map("runtime_metadata")
}

model WorkerHeartbeat {
  workerId String @id @map("worker_id") @db.VarChar(64)
  lastSeen DateTime @map("last_seen") @db.Timestamptz(3)
  @@map("worker_heartbeats")
}

enum UserStatus {
  active
  suspended
  closed
}

enum IndividualCapability {
  Donor
  Beneficiary
  JobSeeker
  Investor
  Volunteer
}

enum OrganizationType {
  NGO
  Company
  Startup
  Foundation
  Institution
}

enum OrganizationStatus {
  active
  suspended
  closed
}

enum MembershipStatus {
  active
  suspended
}

enum MembershipRole {
  Owner
  OrgAdmin
  ProjectManager
  FinanceMaker
  FinanceApprover
  Recruiter
  ProgramManager
  Trainer
  InvestmentManager
  Analyst
  Viewer
  /// PART-12. Three specialisations inside a membership, not new kinds of user
  /// (08-PERMISSION-EXTENSIONS). A mentor comments and does not decide; a coordinator runs the
  /// volunteering and reaches no beneficiary file; a case worker holds assistance and nothing else.
  Mentor
  VolunteerCoordinator
  CaseWorker
}

enum VerificationState {
  not_started
  submitted
  in_review
  changes_requested
  verified
  rejected
  expired
}

enum VerificationDocumentState {
  pending_scan
  clean
  rejected
}

enum VerificationDecisionOutcome {
  changes_requested
  verified
  rejected
}

enum PlatformRole {
  Support
  VerificationReviewer
  ContentReviewer
  FinanceOperator
  RiskReviewer
  PlatformAdmin
  Auditor
  Operations
}

enum MfaChallengeState {
  pending
  verified
  consumed
  cancelled
}

enum OwnershipTransferState {
  pending
  accepted
  expired
}

enum BankChangeRequestState {
  pending
  approved
  rejected
}

enum ProjectType {
  charity
  venture
  enablement
}

enum ProjectState {
  draft
  submitted
  in_review
  changes_requested
  approved
  published
  funding_closed
  executing
  impact_review
  completed
  archived
  paused
  cancelled
  rejected
}

enum LocationPrecision {
  city
  approximate
  exact
}

model User {
  id              String @id @default(uuid()) @db.Uuid
  email           String @unique @db.VarChar(254)
  name            String @db.VarChar(100)
  emailVerified   Boolean @default(false) @map("email_verified")
  image           String?
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  platformAccessVersion Int @default(1) @map("platform_access_version")
  status          UserStatus @default(active)
  termsVersion    String @map("terms_version") @db.VarChar(50)
  termsAcceptedAt DateTime @map("terms_accepted_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile         IndividualProfile?
  party           Party?
  memberships     Membership[]
  sessions        Session[]
  accounts        Account[]
  verificationSubmissions OrganizationVerificationSubmission[] @relation("VerificationSubmitter")
  verificationDecisions OrganizationVerificationDecision[] @relation("VerificationReviewer")
  assignedVerificationCases OrganizationVerificationCase[] @relation("AssignedVerificationReviewer")
  twoFactor       TwoFactor?
  platformGrants  PlatformGrant[] @relation("PlatformGrantSubject")
  platformGrantsIssued PlatformGrant[] @relation("PlatformGrantIssuer")
  platformInvitationsCreated PlatformAccessInvitation[] @relation("PlatformInvitationCreator")
  mfaChallenges   MfaChallenge[]
  notificationPreference NotificationPreference?
  createdInvitations Invitation[] @relation("InvitationCreator")
  declinedInvitations Invitation[] @relation("InvitationDecliner")
  ownershipTransfersCreated OrganizationOwnershipTransfer[] @relation("OwnershipTransferCurrentOwner")
  ownershipTransfersReceived OrganizationOwnershipTransfer[] @relation("OwnershipTransferNewOwner")
  bankChangesRequested OrganizationBankChangeRequest[] @relation("BankChangeRequester")
  bankChangesReviewed OrganizationBankChangeRequest[] @relation("BankChangeReviewer")
  managedProjects Project[] @relation("ProjectManager")
  createdProjects Project[] @relation("ProjectCreator")
  projectVersionsSubmitted ProjectVersion[] @relation("ProjectVersionSubmitter")
  bookmarks       Bookmark[]
  assignedProjects Project[] @relation("ProjectAssignedReviewer")
  budgetRevisions BudgetRevision[] @relation("BudgetRevisionAuthor")
  projectReviews  ProjectReviewDecision[] @relation("ProjectReviewer")
  projectUpdates  ProjectUpdate[] @relation("ProjectUpdateAuthor")
  projectReports  ProjectReport[] @relation("ProjectReportAuthor")
  idempotencyRecords IdempotencyRecord[]
  // PART-08 investment. Each role on a record is its own named relation, so who created, managed,
  // granted, revoked or reviewed something never collapses into one ambiguous link.
  ventures                 Venture[]
  offeringsCreated         Offering[] @relation("OfferingCreator")
  offeringsManaged         Offering[] @relation("OfferingManager")
  offeringDisclosures      OfferingDisclosure[]
  offeringReviews          OfferingReviewDecision[]
  investorEligibility      InvestorEligibility?
  eligibilityDecisions     EligibilityDecision[]
  dataRoomUploads          DataRoomDocument[]
  dataRoomRequests         DataRoomAccessRequest[] @relation("DataRoomRequester")
  dataRoomDecisions        DataRoomAccessRequest[] @relation("DataRoomDecider")
  dataRoomGrants           DataRoomGrant[] @relation("DataRoomGrantee")
  dataRoomGrantsGiven      DataRoomGrant[] @relation("DataRoomGranter")
  dataRoomGrantsRevoked    DataRoomGrant[] @relation("DataRoomRevoker")
  ndaAcceptances           NdaAcceptance[]
  dataRoomDownloads        DataRoomDownload[]
  investorQuestions        InvestorQuestion[]
  investorQuestionReplies  InvestorQuestionReply[]
  offeringInterests        OfferingInterest[]
  // PART-09 investment. Each role stays its own named relation.
  commitments              Commitment[]
  allocationsHeld          Allocation[] @relation("AllocationHolder")
  allocationsFinalised     Allocation[] @relation("AllocationFinaliser")
  allocationRequests       AllocationRequest[] @relation("AllocationRequester")
  allocationDecisions      AllocationRequest[] @relation("AllocationDecider")
  holdings                 Holding[]
  companyReports           CompanyReport[]
  distributionsRequested   Distribution[] @relation("DistributionRequester")
  distributionsApproved    Distribution[] @relation("DistributionApprover")
  corporateEvents          CorporateEvent[]
  // PART-10 enablement. Every role somebody can hold around a programme is its own named relation,
  // because "who ran it", "who reviewed it", "who trained on it" and "who applied to it" are four
  // different people and folding them into one link is how a scope check gets written wrongly.
  candidateProfile         CandidateProfile?
  programsCreated          Program[] @relation("ProgramCreator")
  programsManaged          Program[] @relation("ProgramManagerUser")
  programsUnderReview      Program[] @relation("ProgramReviewer")
  programReviewDecisions   ProgramReviewDecision[]
  cohortsTrained           CohortTrainer[] @relation("CohortTrainerUser")
  cohortTrainersAssigned   CohortTrainer[] @relation("CohortTrainerAssigner")
  applications             Application[]
  applicationReviews       ApplicationReview[]
  applicationDecisions     ApplicationDecision[]
  interviewsScheduled      Interview[]
  rescheduleRequests       InterviewRescheduleRequest[]
  enrollments              Enrollment[]
  withdrawalDecisions      EnrollmentWithdrawalRequest[]
  trainingSessionsCreated  TrainingSession[]
  attendanceRecorded       Attendance[]
  attendanceRevisions      AttendanceRevision[]
  attendanceObjections     AttendanceObjection[] @relation("AttendanceObjector")
  attendanceObjectionDecisions AttendanceObjection[] @relation("AttendanceObjectionDecider")
  assessmentsCreated       Assessment[]
  assessmentResults        AssessmentResult[]
  // PART-11 employment. A candidate, a recruiter and whoever confirmed a start are three different
  // people, so each is its own named relation rather than one ambiguous link.
  jobsCreated              Job[] @relation("JobCreator")
  jobApplications          JobApplication[]
  referralsReceived        JobReferral[] @relation("ReferredCandidate")
  referralsMade            JobReferral[] @relation("JobReferrer")
  jobOffersCreated         JobOffer[]
  placements               Placement[]
  startConfirmations       PlacementStartConfirmation[]
  followupsRecorded        PlacementFollowup[]
  placementReviews         PlacementReviewDecision[]
  // PART-12. Funding, incubation, assistance and volunteering. Each relation is named because the
  // same person can be on several sides of these records — a mentor on one idea and a founder on
  // another — and an ambiguous link would let one be read as the other.
  agreementsCreated        Agreement[]
  agreementRevisions       AgreementRevision[]
  agreementAcceptances     AgreementAcceptance[]
  agreementMilestoneDecisions AgreementMilestoneDecision[]
  agreementReportsAuthored AgreementReport[] @relation("AgreementReportAuthor")
  agreementReportsReviewed AgreementReport[] @relation("AgreementReportReviewer")
  fundingIntents           AgreementFundingIntent[]
  stipendBatches           StipendBatch[]
  certificatesIssued       Certificate[] @relation("CertificateIssuer")
  certificatesRevoked      Certificate[] @relation("CertificateRevoker")
  proposalsOwned           Proposal[] @relation("ProposalOwner")
  proposalDecisions        ProposalDecision[]
  mentoring                MentorAssignment[] @relation("MentorUser")
  mentorAssignmentsMade    MentorAssignment[] @relation("MentorAssigner")
  incubationAgreements     IncubationAgreement[]
  incubationMilestoneDecisions IncubationMilestoneDecision[]
  assistanceCases          AssistanceCase[] @relation("AssistanceApplicant")
  assistanceCasesHandled   AssistanceCase[] @relation("AssistanceCaseWorker")
  assistanceConsents       AssistanceConsent[]
  assistanceMessages       AssistanceMessage[]
  assistanceDecisions      AssistanceDecision[]
  assistanceDeliveries     AssistanceDelivery[]
  volunteerSupervising     VolunteerOpportunity[] @relation("VolunteerSupervisor")
  volunteerOpportunitiesCreated VolunteerOpportunity[] @relation("VolunteerOpportunityCreator")
  volunteerApplications    VolunteerApplication[]
  volunteerAssignments     VolunteerAssignment[] @relation("VolunteerAssignee")
  volunteerAssignmentsMade VolunteerAssignment[] @relation("VolunteerAssigner")
  volunteerHoursApproved   VolunteerHours[] @relation("VolunteerHoursApprover")
  @@map("users")
  // PART-07 money operations. Each is a distinct role on the record, so they are named relations
  // rather than one ambiguous link: who requested, who approved and who executed must stay apart.
  payoutsMade            Payout[] @relation("PayoutMaker")
  payoutsApproved        Payout[] @relation("PayoutApprover")
  payoutsExecuted        Payout[] @relation("PayoutExecutor")
  payoutDecisions        PayoutDecision[]
  refundsRequested       Refund[] @relation("RefundRequester")
  refundsApproved        Refund[] @relation("RefundApprover")
  refundsExecuted        Refund[] @relation("RefundExecutor")
  disputesOpened         Dispute[] @relation("DisputeOpener")
  disputesResolved       Dispute[] @relation("DisputeResolver")
  reconciliationImports  ReconciliationBatch[]
  reconciliationResolved ReconciliationItem[]
}

model TwoFactor {
  id                      String @id @default(uuid()) @db.Uuid
  secret                  String
  backupCodes             String @map("backup_codes")
  userId                  String @unique @map("user_id") @db.Uuid
  verified                Boolean @default(true)
  failedVerificationCount Int @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)
  user                    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("two_factors")
}

model PlatformGrant {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @map("user_id") @db.Uuid
  role       PlatformRole
  grantedBy  String @map("granted_by") @db.Uuid
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User @relation("PlatformGrantSubject", fields: [userId], references: [id], onDelete: Restrict)
  issuer     User @relation("PlatformGrantIssuer", fields: [grantedBy], references: [id], onDelete: Restrict)
  @@index([userId, role, revokedAt, expiresAt])
  @@map("platform_grants")
}

model PlatformAccessInvitation {
  id             String @id @default(uuid()) @db.Uuid
  email          String @db.VarChar(254)
  roles          PlatformRole[]
  tokenHash      String @unique @map("token_hash") @db.Char(64)
  grantExpiresAt DateTime @map("grant_expires_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdBy      String @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  creator        User @relation("PlatformInvitationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  @@index([email, consumedAt, revokedAt])
  @@map("platform_access_invitations")
}

model MfaChallenge {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @map("user_id") @db.Uuid
  sessionId       String @map("session_id") @db.Uuid
  operation       String @db.VarChar(64)
  resourceId      String @map("resource_id") @db.Uuid
  resourceVersion Int @map("resource_version")
  state           MfaChallengeState @default(pending)
  attempts        Int @default(0)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(3)
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  session         Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([userId, sessionId, state, expiresAt])
  @@map("mfa_challenges")
}

model IndividualProfile {
  userId          String @id @map("user_id") @db.Uuid
  displayName     String @map("display_name") @db.VarChar(100)
  locale          String @default("ar") @db.VarChar(5)
  city            String? @db.VarChar(100)
  capabilities    IndividualCapability[] @default([])
  version         Int @default(1)
  user            User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@map("individual_profiles")
}

model Organization {
  id              String @id @default(uuid()) @db.Uuid
  legalName       String @map("legal_name") @db.VarChar(200)
  displayName     String @map("display_name") @db.VarChar(140)
  slug            String @unique @db.VarChar(90)
  publicDescription String @default("") @map("public_description") @db.VarChar(1200)
  sectors         String[] @default([])
  contactEmail    String? @map("contact_email") @db.VarChar(254)
  websiteUrl      String? @map("website_url") @db.VarChar(500)
  contactAddress  String? @map("contact_address") @db.VarChar(300)
  type            OrganizationType
  country         String @db.Char(2)
  city            String @db.VarChar(100)
  status          OrganizationStatus @default(active)
  verification    VerificationState @default(not_started)
  version         Int @default(1)
  createdBy       String @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  currentLogoId   String? @unique @map("current_logo_id") @db.Uuid
  memberships     Membership[]
  invitations     Invitation[]
  party           Party?
  verificationCase OrganizationVerificationCase?
  currentLogo      OrganizationLogoAsset? @relation("CurrentOrganizationLogo", fields: [currentLogoId], references: [id], onDelete: SetNull)
  logoAssets       OrganizationLogoAsset[] @relation("OrganizationLogoAssets")
  ownershipTransfers OrganizationOwnershipTransfer[]
  bankAccount      OrganizationBankAccount?
  bankChangeRequests OrganizationBankChangeRequest[]
  payouts            Payout[]
  projects         Project[]
  venture            Venture?
  offerings          Offering[]
  programs           Program[]
  jobs               Job[]
  agreementsAsSponsor  Agreement[] @relation("AgreementSponsor")
  agreementsAsOperator Agreement[] @relation("AgreementOperator")
  proposalsIncubated   Proposal[] @relation("ProposalIncubator")
  proposalStartup      Proposal? @relation("ProposalStartup")
  assistanceCases      AssistanceCase[]
  volunteerOpportunities VolunteerOpportunity[]
  @@map("organizations")
}

model OrganizationBankAccount {
  id                          String @id @default(uuid()) @db.Uuid
  organizationId              String @unique @map("organization_id") @db.Uuid
  sourceRequestId             String @unique @map("source_request_id") @db.Uuid
  bankName                    String @map("bank_name") @db.VarChar(140)
  accountHolder               String @map("account_holder") @db.VarChar(200)
  accountIdentifierCiphertext String @map("account_identifier_ciphertext") @db.Text
  accountIdentifierHash       String @map("account_identifier_hash") @db.Char(64)
  accountLast4                String @map("account_last4") @db.VarChar(4)
  country                     String @db.Char(2)
  currency                    String @db.Char(3)
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization                Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceRequest               OrganizationBankChangeRequest @relation("AppliedBankChange", fields: [sourceRequestId], references: [id], onDelete: Restrict)
  @@map("organization_bank_accounts")
}

model OrganizationBankChangeRequest {
  id                          String @id @default(uuid()) @db.Uuid
  organizationId              String @map("organization_id") @db.Uuid
  organizationVersion         Int @map("organization_version")
  requestedBy                 String @map("requested_by") @db.Uuid
  bankName                    String @map("bank_name") @db.VarChar(140)
  accountHolder               String @map("account_holder") @db.VarChar(200)
  accountIdentifierCiphertext String @map("account_identifier_ciphertext") @db.Text
  accountIdentifierHash       String @map("account_identifier_hash") @db.Char(64)
  accountLast4                String @map("account_last4") @db.VarChar(4)
  country                     String @db.Char(2)
  currency                    String @db.Char(3)
  state                       BankChangeRequestState @default(pending)
  version                     Int @default(1)
  reviewedBy                  String? @map("reviewed_by") @db.Uuid
  reviewedAt                  DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewReason                String @default("") @map("review_reason") @db.VarChar(1000)
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  organization                Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requester                   User @relation("BankChangeRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  reviewer                    User? @relation("BankChangeReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  appliedAccount              OrganizationBankAccount? @relation("AppliedBankChange")
  @@index([organizationId, state, createdAt])
  @@index([state, createdAt])
  @@map("organization_bank_change_requests")
}

model OrganizationOwnershipTransfer {
  id                  String @id @default(uuid()) @db.Uuid
  organizationId      String @map("organization_id") @db.Uuid
  organizationVersion Int @map("organization_version")
  currentOwnerId      String @map("current_owner_id") @db.Uuid
  newOwnerId          String @map("new_owner_id") @db.Uuid
  tokenHash           String @unique @map("token_hash") @db.Char(64)
  state               OwnershipTransferState @default(pending)
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(3)
  acceptedAt          DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  currentOwner        User @relation("OwnershipTransferCurrentOwner", fields: [currentOwnerId], references: [id], onDelete: Restrict)
  newOwner            User @relation("OwnershipTransferNewOwner", fields: [newOwnerId], references: [id], onDelete: Restrict)
  @@index([organizationId, state, expiresAt])
  @@index([newOwnerId, state, expiresAt])
  @@map("organization_ownership_transfers")
}

model OrganizationLogoAsset {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  organizationVersion Int @map("organization_version")
  fileName        String @map("file_name") @db.VarChar(255)
  storageKey      String @unique @map("storage_key") @db.VarChar(500)
  contentType     String @map("content_type") @db.VarChar(100)
  expectedSize    Int @map("expected_size")
  actualSize      Int? @map("actual_size")
  checksum        String? @db.Char(64)
  uploadTokenHash String? @unique @map("upload_token_hash") @db.Char(64)
  uploadExpiresAt DateTime? @map("upload_expires_at") @db.Timestamptz(3)
  scanState       VerificationDocumentState @default(pending_scan) @map("scan_state")
  scanReason      String? @map("scan_reason") @db.VarChar(64)
  finalizedAt     DateTime? @map("finalized_at") @db.Timestamptz(3)
  classification  String @default("Public") @db.VarChar(32)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  organization    Organization @relation("OrganizationLogoAssets", fields: [organizationId], references: [id], onDelete: Restrict)
  currentFor      Organization? @relation("CurrentOrganizationLogo")
  @@index([organizationId, scanState])
  @@map("organization_logo_assets")
}

model OrganizationVerificationCase {
  id                String @id @default(uuid()) @db.Uuid
  organizationId    String @unique @map("organization_id") @db.Uuid
  registrationNumber String @default("") @map("registration_number") @db.VarChar(100)
  issuingAuthority  String @default("") @map("issuing_authority") @db.VarChar(200)
  registeredAddress String @default("") @map("registered_address") @db.VarChar(300)
  documentExpiresAt DateTime? @map("document_expires_at") @db.Date
  state             VerificationState @default(not_started)
  version           Int @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignedReviewerId String? @map("assigned_reviewer_id") @db.Uuid
  claimedAt         DateTime? @map("claimed_at") @db.Timestamptz(3)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documents         OrganizationVerificationDocument[]
  submissions       OrganizationVerificationSubmission[]
  assignedReviewer  User? @relation("AssignedVerificationReviewer", fields: [assignedReviewerId], references: [id], onDelete: Restrict)
  @@map("organization_verification_cases")
}

model OrganizationVerificationDocument {
  id             String @id @default(uuid()) @db.Uuid
  caseId         String @map("case_id") @db.Uuid
  fileName       String @map("file_name") @db.VarChar(255)
  storageKey     String @unique @map("storage_key") @db.VarChar(500)
  contentType    String @default("application/octet-stream") @map("content_type") @db.VarChar(100)
  expectedSize   Int @default(0) @map("expected_size")
  actualSize     Int? @map("actual_size")
  checksum       String? @db.Char(64)
  uploadTokenHash String? @unique @map("upload_token_hash") @db.Char(64)
  uploadExpiresAt DateTime? @map("upload_expires_at") @db.Timestamptz(3)
  scanState      VerificationDocumentState @default(pending_scan) @map("scan_state")
  scanReason     String? @map("scan_reason") @db.VarChar(64)
  finalizedAt    DateTime? @map("finalized_at") @db.Timestamptz(3)
  classification String @default("HighlySensitive") @db.VarChar(32)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  case           OrganizationVerificationCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  @@index([caseId, scanState])
  @@map("organization_verification_documents")
}

model OrganizationVerificationSubmission {
  id                   String @id @default(uuid()) @db.Uuid
  caseId               String @map("case_id") @db.Uuid
  sequence             Int
  previousSubmissionId String? @unique @map("previous_submission_id") @db.Uuid
  submittedBy          String @map("submitted_by") @db.Uuid
  snapshot             Json
  submittedAt          DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)
  case                 OrganizationVerificationCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  submitter            User @relation("VerificationSubmitter", fields: [submittedBy], references: [id], onDelete: Restrict)
  previousSubmission   OrganizationVerificationSubmission? @relation("VerificationChain", fields: [previousSubmissionId], references: [id], onDelete: Restrict)
  nextSubmission       OrganizationVerificationSubmission? @relation("VerificationChain")
  decision             OrganizationVerificationDecision?
  @@unique([caseId, sequence])
  @@map("organization_verification_submissions")
}

model OrganizationVerificationDecision {
  id           String @id @default(uuid()) @db.Uuid
  submissionId String @unique @map("submission_id") @db.Uuid
  outcome      VerificationDecisionOutcome
  publicReason String @default("") @map("public_reason") @db.VarChar(1000)
  reviewerId   String @map("reviewer_id") @db.Uuid
